# Root-level ignores for the monorepo.
# backend/ keeps its own Rails .gitignore; this file covers repo-wide noise.

# OS / editor
.DS_Store
*.swp

# JetBrains IDE
/.idea/

# Local environment overrides
.env
.env.local
.env.*.local

# Database dumps
/rubygopher_dump.sql
*.dump

# Personal Claude Code config (working rules, skills, local permissions)
/CLAUDE.local.md
/.claude/
