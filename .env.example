# Optional settings for docker compose; copy to .env. Everything works without them.

# Telegram bot from BotFather. Without the token the notifier only logs messages.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# hh.ru application token, if the public API refuses anonymous requests.
HH_TOKEN=

# Tunnel hostname (cloudflared / ngrok) so cloud assistants can reach /mcp/<token>.
PUBLIC_HOST=

# Fetcher: how often and where to look.
FETCH_INTERVAL=15m
FETCH_SOURCES=hh,habr_career,hirify,getmatch
HIRIFY_REMOTE_TYPES=russia

# Shared secret between web and sandboxd (dev default is fine locally).
SANDBOX_TOKEN=dev-sandbox-token
