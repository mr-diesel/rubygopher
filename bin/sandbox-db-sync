#!/usr/bin/env bash
# Copies the development database into sandbox_db, which the console's Rails
# context reads through a SELECT-only role. Uses the servers' own client tools,
# so client/server versions always match.
set -euo pipefail
cd "$(dirname "$0")/.."

docker compose exec -T db pg_dump --username postgres --clean --if-exists --no-owner --no-privileges rubygopher_development \
  | docker compose exec -T sandbox_db psql --quiet --variable=ON_ERROR_STOP=1 --username postgres --dbname rubygopher_development >/dev/null

count=$(docker compose exec -T sandbox_db psql --tuples-only --no-align --username postgres --dbname rubygopher_development \
          --command 'select count(*) from interview_questions')
echo "sandbox database synced: ${count} interview questions"
