= form_with model: [:admin, @question] do |f|
  - if @question.errors.any?
    .flash.alert = @question.errors.full_messages.to_sentence

  .field
    = f.label :label
    = f.text_field :label
  .field
    = f.label :category
    = f.text_field :category, placeholder: "Ruby, Rails, Go, ..."
  .field
    = f.label :question
    = f.text_area :question, rows: 3
  .field
    = f.label :answer
    = f.text_area :answer, rows: 4
  .field
    = f.label :code
    = f.text_area :code, rows: 8, class: "code"
  .field
    = f.label :language
    = f.text_field :language, placeholder: "ruby, go, ..."
  .field
    = f.label :position
    = f.number_field :position
  .actions
    = f.submit
    = link_to "Cancel", admin_interview_questions_path
